closeCorner.CornerRadius = UDim.new(0, 8)
closeCorner.Parent = closeButton

--============================================================
-- UI TOGGLE (open/close menu)
--============================================================
local function setMenu(open)
	menuOpen = open
	panel.Visible = open

	if open then
		panel.Size = UDim2.new(0, 200, 0, 0)
		TweenService:Create(
			panel,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(0, 200, 0, 130) }
		):Play()
	end
end

openButton.MouseButton1Click:Connect(function()
	setMenu(not menuOpen)
end)

closeButton.MouseButton1Click:Connect(function()
	setMenu(false)
end)

--============================================================
-- RIDE TOGGLE
--============================================================
local function toggleRide()
	local pet = currentPet or getEquippedPet()
	if not pet then
		warn("[RidePet] No equipped pet found.")
		return
	end

	riding = not riding

	if riding then
		attachToPet(pet)
		rideEvent:FireServer("ride", pet)
	else
		detachFromPet()
		rideEvent:FireServer("stop", pet)
	end

	rideButton.Text = riding and "🛑  Dismount" or "🚀  Ride Pet"
	rideButton.BackgroundColor3 = riding
		and Color3.fromRGB(90, 45, 45)
		or Color3.fromRGB(45, 90, 60)
end

rideButton.MouseButton1Click:Connect(toggleRide)

--============================================================
-- KEYBINDS
--============================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == CONFIG.ToggleKey then
		toggleRide()
	elseif input.KeyCode == CONFIG.MenuKey then
		setMenu(not menuOpen)
	end
end)

--============================================================
-- CLEANUP ON RESPAWN
--============================================================
player.CharacterAdded:Connect(function()
	riding = false
	rideWeld = nil
	currentPet = nil
	rideButton.Text = "🚀  Ride Pet"
	rideButton.BackgroundColor3 = Color3.fromRGB(45, 90, 60)
end)
