--============================================================
--  RIDE A PET - All-in-One Script (with toggleable UI)
--  Place in: StarterPlayer > StarterPlayerScripts (LocalScript)
--  Requires: A RemoteEvent named "RidePetEvent" in ReplicatedStorage
--============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local rideEvent = ReplicatedStorage:WaitForChild("RidePetEvent")

--============================================================
-- CONFIG
--============================================================
local CONFIG = {
	ToggleKey = Enum.KeyCode.E,     -- ride/dismount key
	MenuKey   = Enum.KeyCode.R,     -- open/close menu key
	SeatOffset = CFrame.new(0, 2.5, 0),
	PetPrefix = "_Pet",
}

--============================================================
-- STATE
--============================================================
local riding = false
local currentPet = nil
local rideWeld = nil
local menuOpen = true

--============================================================
-- PET LOOKUP
--============================================================
local function getEquippedPet()
	local pet = workspace:FindFirstChild(player.Name .. CONFIG.PetPrefix)
	if pet then return pet end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:GetAttribute("Owner") == player.Name then
			return obj
		end
	end
	return nil
end

--============================================================
-- RIDING LOGIC
--============================================================
local function attachToPet(pet)
	local character = player.Character
	if not character or not pet then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local petPart = pet:FindFirstChild("HumanoidRootPart")
		or pet:FindFirstChildWhichIsA("BasePart")
	if not hrp or not petPart then return end

	if rideWeld then rideWeld:Destroy() end

	rideWeld = Instance.new("Weld")
	rideWeld.Name = "PetRideWeld"
	rideWeld.Part0 = petPart
	rideWeld.Part1 = hrp
	rideWeld.C0 = CONFIG.SeatOffset
	rideWeld.Parent = hrp

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.PlatformStand = true end

	currentPet = pet
end

local function detachFromPet()
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.PlatformStand = false end
	end
	if rideWeld then
		rideWeld:Destroy()
		rideWeld = nil
	end
	currentPet = nil
end

