-- Ride/Dismount button inside panel
local rideButton = Instance.new("TextButton")
rideButton.Size = UDim2.new(1, -24, 0, 42)
rideButton.Position = UDim2.new(0, 12, 0, 42)
rideButton.BackgroundColor3 = Color3.fromRGB(45, 90, 60)
rideButton.TextColor3 = Color3.fromRGB(255, 255, 255)
rideButton.Font = Enum.Font.GothamMedium
rideButton.TextSize = 15
