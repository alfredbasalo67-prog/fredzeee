--==================================================
-- PET DETECTION
--==================================================

local function getPet()
	if not petFolder then
		return nil
	end

	local closest
	local shortest = math.huge

	for _, obj in ipairs(petFolder:GetChildren()) do
		local part

		if obj:IsA("BasePart") then
			part = obj
		elseif obj:IsA("Model") then
			part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
		end

		if part and root then
			local distance = (root.Position - part.Position).Magnitude

			if distance < shortest then
				shortest = distance
				closest = obj
			end
		end
	end

	return closest
end

--==================================================
-- RIDE PET
--==================================================

local weld

local function getPetPart(pet)
	if not pet then
		return nil
	end

	if pet:IsA("BasePart") then
		return pet
	end

	if pet:IsA("Model") then
		return pet.PrimaryPart or pet:FindFirstChildWhichIsA("BasePart")
	end
end

local function ridePet()
	if riding then
		if weld then
			weld:Destroy()
			weld = nil
		end

		riding = false
		rideButton.Text = "🐾  Ride Pet"
		return
	end

	local pet = getPet()
	local petPart = getPetPart(pet)

	if not petPart or not root then
		rideButton.Text = "❌ No Pet Found"
		task.delay(1.5, function()
			if rideButton then
				rideButton.Text = "🐾  Ride Pet"
			end
		end)
		return
	end

	petPart.CFrame = root.CFrame * CFrame.new(0, -2.5, 0)

	weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = petPart
	weld.Parent = root

	riding = true
	rideButton.Text = "🛑  Dismount"
end

rideButton.MouseButton1Click:Connect(ridePet)

--==================================================
-- EGG ESP
--==================================================

local highlighted = {}

local function clearESP()
	for _, item in ipairs(highlighted) do
		if item and item.Parent then
			item:Destroy()
		end
	end

	table.clear(highlighted)
end

local function createESP()
	clearESP()

	if not eggFolder then
		return
	end

	for _, egg in ipairs(eggFolder:GetChildren()) do
		local part

		if egg:IsA("BasePart") then
			part = egg
		elseif egg:IsA("Model") then
			part = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
		end

		if part then
			local highlight = Instance.new("Highlight")
			highlight.Name = "AlfredexEggESP"
			highlight.Adornee = egg
			highlight.FillTransparency = 0.65
			highlight.OutlineTransparency = 0
			highlight.Parent = egg

			table.insert(highlighted, highlight)
		end
	end
end

eggButton.MouseButton1Click:Connect(function()
	eggESPEnabled = not eggESPEnabled

	if eggESPEnabled then
		eggButton.Text = "🥚  Egg ESP: ON"
		createESP()
	else
		eggButton.Text = "🥚  Egg ESP: OFF"
		clearESP()
	end
end)

--==================================================
-- NEAREST EGG
--==================================================

local function getNearestEgg()
	if not eggFolder or not root then
		return nil
	end

	local closest
	local shortest = math.huge

	for _, egg in ipairs(eggFolder:GetChildren()) do
		local part

		if egg:IsA("BasePart") then
			part = egg
		elseif egg:IsA("Model") then
			part = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
		end

		if part then
			local distance = (root.Position - part.Position).Magnitude

			if distance < shortest then
				shortest = distance
				closest = part
			end
		end
	end

	return closest, shortest
end

nearestButton.MouseButton1Click:Connect(function()
	local egg, distance = getNearestEgg()

	if egg then
		nearestButton.Text = "📍 " .. math.floor(distance) .. " studs"

		task.delay(2, function()
			if nearestButton then
				nearestButton.Text = "📍  Nearest Egg"
			end
		end
	else
		nearestButton.Text = "❌ No Eggs"

		task.delay(1.5, function()
			if nearestButton then
				nearestButton.Text = "📍  Nearest Egg"
			end
		end)
	end
end)

--==================================================
-- HOME TELEPORT
--==================================================

homeButton.MouseButton1Click:Connect(function()
	if not root or not home then
		homeButton.Text = "❌ Home Missing"

		task.delay(1.5, function()
			homeButton.Text = "🏠  Teleport Home"
		end)

		return
	end

	local destination

	if home:IsA("BasePart") then
		destination = home
	elseif home:IsA("Model") then
		destination = home.PrimaryPart or home:FindFirstChildWhichIsA("BasePart")
	end

	if destination then
		root.CFrame = destination.CFrame + Vector3.new(0, 4, 0)
	end
end)

